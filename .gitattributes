# Normalise line endings across macOS / Linux / Windows.
* text=auto eol=lf

# Notebooks are JSON; treat as text but don't try to auto-merge their outputs line by line.
*.ipynb text eol=lf linguist-detectable=true

# Data and binary files.
*.csv  text eol=lf linguist-generated=false
*.png  binary
*.jpg  binary
*.pdf  binary
